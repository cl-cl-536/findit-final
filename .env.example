
# ==============================================================================
# FindIt – Cloud-Based Lost and Found Item Management System
# Environment Configuration Template
# ==============================================================================

# Flask Security
SECRET_KEY=replace-with-a-long-random-secret-key

# Database Configuration
# Local development
DATABASE_URL=sqlite:///findit.db

# AWS RDS MySQL example (configure only on EC2)
# DATABASE_URL=mysql+pymysql://finditadmin:YOUR_URL_ENCODED_PASSWORD@YOUR_RDS_ENDPOINT:3306/finditdb

# Initial Campus Administrator Credentials
ADMIN_NAME=Campus Administrator
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# AWS S3 Configuration
S3_BUCKET=
AWS_REGION=us-east-1

# Flask Environment
FLASK_DEBUG=0
PORT=5000

